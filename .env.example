# ---------------------------------------------------------------------------
# Finta Spot configuration
# Copy to `.env.local`. NEVER commit real secrets. Keys are read on the server
# only and are never exposed to client-side JavaScript.
# ---------------------------------------------------------------------------

# Sportmonks Football API token (optional paid fallback). Server-side only.
# Not required — FotMob is the free primary provider.
SPORTMONKS_API_KEY=

# Provider toggles. Priority order is FotMob → Sportmonks.
FOTMOB_ENABLED=true
SPORTMONKS_ENABLED=true

# Automatic fallback / recovery
AUTO_FALLBACK=true

# FotMob health check timeout (milliseconds)
FOTMOB_HEALTHCHECK_TIMEOUT_MS=5000

# Cooldown (seconds) after a confirmed hard block before FotMob is retried
FOTMOB_BLOCK_COOLDOWN_SECONDS=900

# Consecutive temporary failures before FotMob is treated as down
FOTMOB_FAILURE_THRESHOLD=3

# UI live refresh cadence (seconds)
LIVE_REFRESH_SECONDS=60

# ---------------------------------------------------------------------------
# Email alerts (Resend). Sends an email when a match crosses the goals-owed
# threshold. Server-side only — never exposed to the client.
# ---------------------------------------------------------------------------

# Resend API key (https://resend.com). Alerts are disabled without it.
RESEND_API_KEY=

# Toggle alerts (default true when a Resend key is present)
ALERTS_ENABLED=true

# Where alerts are sent
ALERT_TO_EMAIL=finta.sports.corp@gmail.com

# From address. Use the Resend test sender until you verify a domain.
ALERT_FROM_EMAIL=Finta Spot <onboarding@resend.dev>

# Net xG − goals threshold that triggers an alert
ALERT_GOALS_OWED_THRESHOLD=0.8

# ---------------------------------------------------------------------------
# Low-latency alerting (primary): cron-job.org hits /api/alerts/check every ~60s.
# These must be set as VERCEL environment variables (the endpoint runs on Vercel).
# ---------------------------------------------------------------------------

# Upstash Redis (free tier) — shared de-dup state across schedulers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret the external cron must send as `?token=` or `Authorization: Bearer`.
ALERT_CRON_SECRET=

# GitHub Actions (.github/workflows/goal-alerts.yml) is a manual fallback that
# shares the same Upstash state. Set the same RESEND_*/ALERT_*/UPSTASH_* values
# as GitHub repo secrets there.
